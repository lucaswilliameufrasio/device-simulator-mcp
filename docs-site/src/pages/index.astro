---
import "../styles/global.css";

const title = "Device Simulator MCP | Give your agent a real screen";
const description =
  "A local MCP server for inspecting and controlling booted iOS Simulators and Android Emulators.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111417" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-graphite text-paper antialiased">
    <main class="mx-auto max-w-[1240px] px-5 sm:px-8">
      <nav class="flex min-h-20 items-center justify-between border-b border-steel" aria-label="Main navigation">
        <a class="flex min-w-0 items-center gap-3 font-mono text-xs font-semibold text-paper" href="/">
          <span class="grid size-8 shrink-0 place-items-center rounded-sm bg-mint text-graphite">DS</span>
          <span class="truncate">device-simulator-mcp</span>
        </a>
        <div class="flex items-center gap-5 font-mono text-xs text-fog">
          <a class="hidden transition-colors hover:text-paper focus-visible:outline-2 focus-visible:outline-mint sm:block" href="#tools">Tools</a>
          <a class="hidden transition-colors hover:text-paper focus-visible:outline-2 focus-visible:outline-mint sm:block" href="#install">Install</a>
          <a class="border border-steel px-3 py-2 text-paper transition-colors hover:border-mint focus-visible:outline-2 focus-visible:outline-mint" href="https://github.com/lucaswilliameufrasio/device-simulator-mcp">GitHub</a>
        </div>
      </nav>

      <section class="grid gap-12 border-b border-steel py-16 sm:py-24 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20 lg:py-28">
        <div class="flex flex-col justify-center">
          <p class="mb-6 font-mono text-xs text-mint">local MCP / real devices</p>
          <h1 class="max-w-2xl text-[clamp(3.2rem,8vw,7.6rem)] font-semibold leading-[0.9] tracking-[-0.075em] text-paper">
            Give your agent a real screen.
          </h1>
          <p class="mt-8 max-w-lg text-base leading-7 text-fog sm:text-lg">
            Inspect the iOS Simulator or Android Emulator already on your machine.
            Capture it, act on it, and return visual proof through MCP.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a class="bg-mint px-5 py-3 text-sm font-semibold text-graphite transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-mint" href="#install">Install locally</a>
            <a class="border border-steel px-5 py-3 text-sm font-semibold text-paper transition-colors hover:border-paper focus-visible:outline-2 focus-visible:outline-mint" href="#tools">See the tools</a>
          </div>
          <div class="mt-12 flex flex-wrap gap-x-7 gap-y-2 font-mono text-xs text-fog">
            <span><b class="font-medium text-mint">iOS</b> via serve-sim</span>
            <span><b class="font-medium text-orange">Android</b> via adb</span>
            <span>stdio transport</span>
          </div>
        </div>

        <div class="trace-panel self-start overflow-hidden border border-steel bg-panel shadow-[12px_12px_0_#263033]" aria-label="MCP command trace">
          <div class="flex items-center justify-between border-b border-steel px-4 py-3 font-mono text-[11px] text-fog sm:px-6">
            <span>agent / device loop</span>
            <span class="flex items-center gap-2"><i class="size-2 rounded-full bg-mint"></i> connected</span>
          </div>
          <div class="p-4 sm:p-6">
            <div class="mb-6 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 border-b border-steel pb-6 font-mono text-xs">
              <span class="text-fog">platform</span><span class="text-orange">ios</span>
              <span class="text-fog">target</span><span class="break-all text-paper">A0F98A83-314C-4FCD</span>
              <span class="text-fog">transport</span><span class="text-mint">stdio</span>
            </div>
            <div class="space-y-3 font-mono text-xs leading-6 sm:text-sm">
              <div class="trace-row"><span class="text-fog">01</span><span class="text-orange">device_capture</span><span class="text-fog">checkout</span><b class="text-mint">PNG returned</b></div>
              <div class="trace-row"><span class="text-fog">02</span><span class="text-orange">device_tap</span><span class="text-fog">0.52, 0.71</span><b class="text-mint">input submitted</b></div>
              <div class="trace-row"><span class="text-fog">03</span><span class="text-orange">device_type</span><span class="text-fog">email</span><b class="text-mint">input sent</b></div>
              <div class="trace-row"><span class="text-fog">04</span><span class="text-orange">device_capture</span><span class="text-fog">after-login</span><b class="text-mint">PNG returned</b></div>
            </div>
            <div class="mt-7 flex items-center justify-between border-t border-steel pt-4 font-mono text-[11px] text-fog">
              <span>local only</span><span class="text-paper">no remote service</span>
            </div>
          </div>
          <div class="h-1 bg-[linear-gradient(90deg,var(--color-mint)_0_58%,var(--color-orange)_58%_75%,transparent_75%)]"></div>
        </div>
      </section>

      <section id="tools" class="grid gap-10 border-b border-steel py-16 sm:py-24 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20 lg:py-28">
        <div>
          <p class="font-mono text-xs text-mint">What it exposes</p>
          <h2 class="mt-5 max-w-md text-4xl font-semibold leading-[0.95] tracking-[-0.06em] sm:text-5xl">A small command surface for visual feedback.</h2>
          <p class="mt-6 max-w-md text-sm leading-7 text-fog sm:text-base">
            The server does not install or change your app. It connects to the device
            you already booted and keeps the screenshot in the local feedback loop.
          </p>
        </div>
        <div class="divide-y divide-steel border-y border-steel">
          <div class="tool-row"><code class="text-mint">device_capture</code><p>Return PNG by default, or request a smaller JPEG, resize, or crop.</p></div>
          <div class="tool-row"><code class="text-orange">device_step</code><p>Run known actions in order with one optional final screenshot. Bounded deadline and partial-completion reporting.</p></div>
          <div class="tool-row"><code class="text-mint">device_inspect</code><p>Fetch bounded iOS accessibility on demand through the opt-in persistent backend.</p></div>
          <div class="tool-row"><code class="text-orange">device_tap</code><p>Tap normalized coordinates from 0 to 1.</p></div>
          <div class="tool-row"><code class="text-mint">device_swipe</code><p>Move through a screen with one platform-neutral gesture.</p></div>
          <div class="tool-row"><code class="text-orange">device_type</code><p>Type into the focused control on either platform.</p></div>
          <div class="tool-row"><code class="text-paper">device_repair_input</code><p>Repair iOS Simulator input services. Restarts SpringBoard and closes running apps.</p></div>
          <div class="tool-row"><code class="text-paper">device_status</code><p>Show which simulator or emulator is available.</p></div>
        </div>
      </section>

      <section class="border-b border-steel py-16 sm:py-20">
        <p class="font-mono text-xs text-mint">Fewer processes / smaller observations</p>
        <h2 class="mt-5 max-w-2xl text-3xl font-semibold leading-tight tracking-[-0.05em] sm:text-4xl">Keep the connection. Request only what you need.</h2>
        <div class="mt-6 max-w-3xl space-y-4 text-sm leading-7 text-fog sm:text-base">
          <p>The opt-in iOS backend connects directly to a pinned serve-sim server over a reusable WebSocket. Latest-frame capture can avoid simctl, but frames may be replayed: it is not proof that an action finished rendering.</p>
          <p>Use <code class="font-mono text-paper">device_step</code> for already-known actions and one final observation. Choose JPEG and a maximum dimension to reduce image payloads. Fresh PNG capture remains the compatible default; continuous video is not added to model context.</p>
          <p>Android keeps ADB as the default. Emulator gRPC is an authenticated, experimental opt-in backend, not a validated replacement yet. Helpers started by this MCP are owned and cleaned up; externally started streams are never stopped.</p>
          <a class="inline-block border-b border-mint text-mint focus-visible:outline-2 focus-visible:outline-mint" href="https://github.com/lucaswilliameufrasio/device-simulator-mcp#faster-agent-loops">Backend setup, limits, and benchmarks</a>
        </div>
      </section>

      <section class="border-b border-steel py-16 sm:py-20">
        <p class="font-mono text-xs text-mint">Xcode 27 input troubleshooting</p>
        <h2 class="mt-5 max-w-2xl text-3xl font-semibold leading-tight tracking-[-0.05em] sm:text-4xl">Keep Device Hub and the Simulator ready for input.</h2>
        <div class="mt-6 max-w-3xl space-y-4 text-sm leading-7 text-fog sm:text-base">
          <p>With Xcode 27, Device Hub must be open and the target Simulator window visible and frontmost. macOS may require Accessibility permission for the app that launched this MCP server; check System Settings → Privacy &amp; Security → Accessibility.</p>
          <p>If keyboard or touch input still fails, call <code class="font-mono text-paper">device_repair_input</code> explicitly. It restarts SpringBoard and closes running apps. Then restart the stream with <code class="font-mono text-paper">device_stop</code> and <code class="font-mono text-paper">device_start</code>, and reopen the app. The repair is never triggered automatically by typing.</p>
        </div>
      </section>

      <section id="install" class="grid gap-8 border-b border-steel py-16 sm:py-24 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20 lg:py-28">
        <div>
          <p class="font-mono text-xs text-mint">Start from your terminal</p>
          <h2 class="mt-5 max-w-md text-4xl font-semibold leading-[0.95] tracking-[-0.06em] sm:text-5xl">One server. Two device targets.</h2>
          <p class="mt-6 max-w-md text-sm leading-7 text-fog sm:text-base">
            Install the binary once, boot a device, then choose iOS or Android with one environment variable.
          </p>
        </div>
        <div class="grid min-w-0 gap-px border border-steel bg-steel sm:grid-cols-2">
          <div class="install-option bg-panel p-4 sm:p-6">
            <p class="font-mono text-xs text-mint">iOS</p>
            <pre class="m-0 mt-4 max-w-full whitespace-pre-wrap break-words font-mono text-xs leading-6 text-fog sm:text-sm"><code>DEVICE_PLATFORM=ios
device-simulator-mcp</code></pre>
            <p class="mt-4 text-xs leading-5 text-fog">Uses <code class="font-mono text-paper">serve-sim</code> and the selected Simulator.</p>
          </div>
          <div class="install-option bg-panel p-4 sm:p-6">
            <p class="font-mono text-xs text-orange">Android</p>
            <pre class="m-0 mt-4 max-w-full whitespace-pre-wrap break-words font-mono text-xs leading-6 text-fog sm:text-sm"><code>DEVICE_PLATFORM=android
device-simulator-mcp</code></pre>
            <p class="mt-4 text-xs leading-5 text-fog">Uses <code class="font-mono text-paper">adb</code> and the selected Emulator.</p>
          </div>
        </div>
      </section>

      <section class="border-b border-steel py-16 sm:py-20">
        <p class="font-mono text-xs text-mint">Configure an AI client</p>
        <h2 class="mt-5 max-w-2xl text-3xl font-semibold leading-tight tracking-[-0.05em] sm:text-4xl">Preview the MCP entry, then apply it.</h2>
        <p class="mt-5 max-w-3xl text-sm leading-7 text-fog sm:text-base">
          The CLI registers the stdio server for OpenCode, Claude Code, Codex CLI, Cursor, or Gemini CLI. It defaults to user-wide iOS configuration; choose <code class="font-mono text-paper">--scope project</code> or <code class="font-mono text-paper">--platform android</code> when needed.
        </p>
        <pre class="mt-6 max-w-3xl overflow-x-auto border border-steel bg-panel p-5 font-mono text-xs leading-6 text-fog sm:text-sm"><code>device-simulator-mcp install-mcp --client opencode
device-simulator-mcp install-mcp --client opencode --apply</code></pre>
        <p class="mt-4 text-xs leading-5 text-fog">Applying updates only this server's entry and preserves other settings. Restart the AI client afterward. This registers MCP and does not install lifecycle hooks.</p>
      </section>

      <section class="flex flex-col gap-7 py-16 sm:py-24 lg:flex-row lg:items-end lg:justify-between lg:py-28">
        <div>
          <p class="font-mono text-xs text-mint">Built for local visual feedback</p>
          <h2 class="mt-5 max-w-3xl text-4xl font-semibold leading-[0.92] tracking-[-0.07em] sm:text-6xl">The device is yours. The screenshot stays yours.</h2>
        </div>
        <a class="shrink-0 border-b border-mint pb-1 font-mono text-xs text-mint transition-colors hover:text-paper focus-visible:outline-2 focus-visible:outline-mint" href="https://github.com/lucaswilliameufrasio/device-simulator-mcp">Read the source</a>
      </section>

      <footer class="flex flex-col gap-2 border-t border-steel py-7 font-mono text-[11px] text-fog sm:flex-row sm:justify-between">
        <span>device-simulator-mcp / 2026</span>
        <span>iOS + Android / local by design</span>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(body) { margin: 0; font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif; }
  :global(a) { text-decoration: none; }
  .trace-row { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); gap: 0 0.75rem; }
  .trace-row span:nth-child(3), .trace-row b { grid-column: 2; }
  .trace-row b { font-weight: 400; color: var(--color-mint); }
  .tool-row { display: grid; gap: 0.75rem; padding: 1.25rem 0; }
  .tool-row code { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 0.8rem; }
  .tool-row p { margin: 0; color: var(--color-fog); font-size: 0.95rem; line-height: 1.6; }
  @media (min-width: 640px) {
    .trace-row { grid-template-columns: 1.5rem 10rem 1fr auto; align-items: baseline; }
    .trace-row span:nth-child(3), .trace-row b { grid-column: auto; }
    .tool-row { grid-template-columns: 10rem 1fr; align-items: baseline; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; }
  }
</style>
